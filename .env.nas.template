# ─────────────────────────────────────────────────────────────
# Alpha @ NAS 环境变量模板
# 用法： cp .env.nas.template .env  然后按需修改
# ─────────────────────────────────────────────────────────────

# 容器内监听（docker-compose.nas.yml 会用 environment 覆盖成 0.0.0.0:18888）
HOST=0.0.0.0
PORT=18888
RELOAD=0

# ─── 写操作令牌（必填！）──────────────────────────────────────
# 局域网端口已开放，写接口（手动触发同步/策略写入等）必须带此 token。
# 生成一个：  openssl rand -hex 16   或   python3 -c "import secrets;print(secrets.token_hex(16))"
ALPHA_WRITE_TOKEN=please-change-me-16-hex-chars

# ─── 数据源 ────────────────────────────────────────────────
ENABLE_TUSHARE=false
TUSHARE_TOKEN=
ENABLE_LIVE_MARKET_DATA=true

# ─── LLM（可选，任意 OpenAI 兼容服务；不填则相关面板显示未启用）──
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# HERMES_MODEL=deepseek-chat

# ─── 代理（可选；NAS 出口需要代理抓行情时启用）─────────────────
# HTTPS_PROXY=http://127.0.0.1:10809
# HTTP_PROXY=http://127.0.0.1:10809
