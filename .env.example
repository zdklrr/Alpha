# ─────────────────────────────────────────────────────────────
# Alpha 环境变量示例 — 拷贝为 .env 后按需修改
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ─── Tushare 数据源（可选增强）──────────────────────────────
# 不配置也能完整运行（自动使用东方财富/新浪免费源）；
# 配置 Token 后日线补缺与交易日历会多一层可信兜底。禁止提交真实 Token。
ENABLE_TUSHARE=false
TUSHARE_TOKEN=
ENABLE_LIVE_MARKET_DATA=true

# ─── LLM 配置（任选其一，均为 OpenAI 兼容协议）────────────────
# Windows 裸机推荐用脚本一键写入并自检：
#   .\set-llm.ps1 -Provider deepseek -ApiKey sk-xxxx -Restart -Test
#   .\set-llm.ps1 -Provider qwen -ApiKey sk-xxxx -Model qwen-plus
#   .\set-llm.ps1 -Provider lmstudio -Model <本地模型名> -Restart -Test
#
# 方案 A：云端 OpenAI 兼容服务（任选其一）
# DeepSeek（便宜、国内直连）
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# HERMES_MODEL=deepseek-chat
# 阿里云百炼 DashScope（通义千问）
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HERMES_MODEL=qwen-plus
# 智谱 GLM
# OPENAI_API_KEY=xxxxxxxx.xxxxx
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# HERMES_MODEL=glm-4-flash
# SiliconFlow
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# HERMES_MODEL=Qwen/Qwen2.5-7B-Instruct
# OpenAI 官方
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# HERMES_MODEL=gpt-4o-mini

# 方案 B：本地推理服务（OpenAI 兼容端点，任选其一）
# Ollama: 先 `ollama serve` 与 `ollama pull qwen2.5:7b`
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# HERMES_MODEL=qwen2.5:7b
# LM Studio: 默认端口 1234
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# HERMES_MODEL=local-model
# llama.cpp server / vLLM: 默认端口 8080 / 8000
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# HERMES_MODEL=local-model

# 方案 C：独立 hermes-agent API Server（如已部署）
# HERMES_AGENT_URL=http://127.0.0.1:8642/v1
# API_SERVER_KEY=your_api_server_bearer_token

# ─── 通知 ────────────────────────────────────────────────
# FEISHU_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxx
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# ─── 服务 ────────────────────────────────────────────────
# 裸机运行默认仅监听本机；如需局域网访问改为 0.0.0.0（请同时配置 ALPHA_WRITE_TOKEN）。
# Docker 部署不受此项影响（容器内固定绑 0.0.0.0，由 compose 端口映射控制暴露面）。
PORT=18888
HOST=127.0.0.1
RELOAD=0

# ─── 写操作令牌（可选，远程写入必配）─────────────────────────
# 配置后所有 POST/PUT/DELETE 需携带 X-Alpha-Token 头；留空时写操作仅限本机。
# MCP Server 会自动读取同一变量附加请求头。禁止提交真实令牌到 Git。
# ALPHA_WRITE_TOKEN=

# ─── Docker/边界部署写防护适配（可选）────────────────────────
# 经端口发布 NAT 的环境（docker compose 等）容器内看不到真实来源 IP，
# 置 1 表示信任宿主机端口绑定作为访问边界（compose 默认仅绑 127.0.0.1）。
# ⚠️ 若同时把端口暴露到局域网，必须改用 ALPHA_WRITE_TOKEN 模式。
# ALPHA_TRUST_EDGE=1
